{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Запрос кода без телефона",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-Device-Id": "test-device-1"
      },
      "body": {
        "action": "request_code",
        "purpose": "login",
        "channel": "sms",
        "phone": ""
      },
      "expectedStatus": 400
    },
    {
      "name": "Проверка устройства",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-Device-Id": "test-device-1"
      },
      "body": {
        "action": "check_device",
        "phone": "+79990000042"
      },
      "expectedStatus": 200
    },
    {
      "name": "Проверка кода без телефона",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-Device-Id": "test-device-1"
      },
      "body": {
        "action": "verify_code",
        "purpose": "login",
        "channel": "sms",
        "phone": "",
        "code": ""
      },
      "expectedStatus": 400
    },
    {
      "name": "Вход по неверному паролю",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "login_password",
        "login": "nouser",
        "password": "wrong"
      },
      "expectedStatus": 404
    },
    {
      "name": "Регистрация без телефона",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "request_code",
        "purpose": "register",
        "channel": "sms",
        "phone": "",
        "email": "a@b.ru",
        "password": "abc12",
        "consent": true
      },
      "expectedStatus": 400
    },
    {
      "name": "Регистрация с некорректным email",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "request_code",
        "purpose": "register",
        "channel": "sms",
        "phone": "+79995558877",
        "email": "bad",
        "password": "abc12",
        "consent": true
      },
      "expectedStatus": 400
    },
    {
      "name": "Регистрация с длинным паролем",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "request_code",
        "purpose": "register",
        "channel": "sms",
        "phone": "+79995558877",
        "email": "a@b.ru",
        "password": "abc1234",
        "consent": true
      },
      "expectedStatus": 400
    },
    {
      "name": "Регистрация без согласия",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "request_code",
        "purpose": "register",
        "channel": "sms",
        "phone": "+79995558877",
        "email": "a@b.ru",
        "password": "abc12",
        "consent": false
      },
      "expectedStatus": 400
    },
    {
      "name": "Заявка на семейный тариф без сессии",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "request_family_plan",
        "code_word": "тест"
      },
      "expectedStatus": 401
    },
    {
      "name": "Заявка на семейный тариф без кодового слова",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "request_family_plan",
        "code_word": ""
      },
      "expectedStatus": 400
    },
    {
      "name": "Список заявок без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_list_family_requests"
      },
      "expectedStatus": 403
    },
    {
      "name": "Решение по заявке без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_decide_family_request",
        "request_id": 1,
        "decision": "approved"
      },
      "expectedStatus": 403
    },
    {
      "name": "Получить кодовое слово без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_get_family_code"
      },
      "expectedStatus": 403
    },
    {
      "name": "Назначить кодовое слово без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_set_family_code",
        "code_word": "Семья2026",
        "expires_at": "2026-12-31"
      },
      "expectedStatus": 403
    },
    {
      "name": "Назначить пароль пользователю без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_set_user_password",
        "login": "test",
        "password": "test123"
      },
      "expectedStatus": 403
    },
    {
      "name": "Выдать доступ без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_grant_access",
        "target": "app",
        "login": "test",
        "password": "test123"
      },
      "expectedStatus": 403
    },
    {
      "name": "Список доступов без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_list_access"
      },
      "expectedStatus": 403
    },
    {
      "name": "Отозвать доступ без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_revoke_access",
        "id": 1
      },
      "expectedStatus": 403
    },
    {
      "name": "Список пользователей без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_list_users"
      },
      "expectedStatus": 403
    },
    {
      "name": "Обращение в поддержку без текста",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "support_create",
        "message": ""
      },
      "expectedStatus": 400
    },
    {
      "name": "Список обращений без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_list_tickets"
      },
      "expectedStatus": 403
    },
    {
      "name": "Ответ на обращение без прав администратора",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_answer_ticket",
        "id": 1,
        "answer": "тест"
      },
      "expectedStatus": 403
    }
  ]
}